# Optional. The client calls /api/* relatively:
#   - dev:    Vite proxies /api to VITE_PROXY_TARGET (default http://localhost:4000)
#   - docker: nginx proxies /api to the server container
# Only set VITE_API_BASE if the API lives on a different origin.
# VITE_API_BASE=
# VITE_PROXY_TARGET=http://localhost:4000
